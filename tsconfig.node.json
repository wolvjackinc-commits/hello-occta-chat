{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases (shared with app config) */
    "paths": {
      "@/*": ["./src/*"],
      /* @vitejs/plugin-react-swc is symlinked into node_modules/.deno and would
         otherwise type-resolve `vite` to a second copy (5.4.21) while this config
         uses the top-level one (5.4.19), making the plugins array incompatible.
         Typecheck-only alias: one Vite identity for the node config project. */
      "vite": ["./node_modules/vite"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
